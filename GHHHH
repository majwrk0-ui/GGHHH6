-- تنظيف الكشف
local function ClearESP()
    for _, drawingGroup in pairs(ESPDrawings) do
        if drawingGroup.Line then drawingGroup.Line:Remove() end
        if drawingGroup.Text then drawingGroup.Text:Remove() end
        if drawingGroup.Highlight then drawingGroup.Highlight:Destroy() end
    end
    ESPDrawings = {}
    for _, conn in pairs(ESPConnections) do conn:Disconnect() end
    ESPConnections = {}
end

